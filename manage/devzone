#!/usr/bin/env bash
# devzone command on your machine (npm package):
#   devzone <folder>         creates a devzone in <folder>, then starts it
#   devzone update           in a devzone folder: moves to the package version
#   devzone uninstall        in a devzone folder: removes everything it created
#   devzone --version | --help
# In the container, « devzone » is another command: the modules
# (.devcontainer/devzone).
# DEVZONE_NO_START=1: copy only, without starting the container (tests).
# The helpers live in manage/scripts/devzone-*.sh, sourced by the command that
# needs them (so --version and --help work with this file alone).
# shellcheck disable=SC2034 # PACKAGE_ITEMS, GITIGNORE_LINES: read by the sourced devzone-*.sh
set -euo pipefail

# Script path. From cmd, the npm .cmd shim calls bash with the Windows path
# (C:\…\bin\devzone): without "/", dirname/readlink would give "." and PAQUET
# would be wrong. We normalize first (cygpath from Git Bash, else \ → /);
# macOS/Linux: POSIX path, unchanged.
SCRIPT="${BASH_SOURCE[0]}"
case "$SCRIPT" in
    [A-Za-z]:[\\/]*) SCRIPT="$(cygpath -u "$SCRIPT" 2>/dev/null || echo "${SCRIPT//\\//}")" ;;
esac
PAQUET="$(cd "$(dirname "$(readlink -f "$SCRIPT" 2>/dev/null || echo "$SCRIPT")")/.." && pwd)"
# Items copied into a devzone (same list as the « files » of package.json,
# without the command manage/devzone); manage/scripts is copied apart, under manage/
PACKAGE_ITEMS=(.devcontainer Makefile .gitattributes README.md LICENSE)
# Lines always present in the .gitignore of a devzone: added to, never overwritten
GITIGNORE_LINES=(
    '# Chaque projet du workspace a son propre dépôt git'
    'workspace/*'
    '!workspace/.gitkeep'
    '.DS_Store'
    '.devzone.log'
    '.devzone.etat'
    '.password'
    '.devzone.sauvegarde/'
    '.devcontainer/sans-docker-hote/'
    '.devcontainer/without-host-docker/'
)

# Version of the package (package.json next to manage/)
version() {
    # Path passed as an argument to node, never written in the JavaScript code of -p:
    # under Git Bash $PAQUET is /c/… and only a separate argument is converted
    # for a Windows program (cygpath not needed)
    node -p 'require(process.argv[1]).version' "$PAQUET/package.json" 2>/dev/null || echo inconnue
}

show_help() {
    cat <<EOT
devzone $(version) : environnement de développement conteneurisé

  devzone <dossier> [--gitops github|none|<url>] [--kubernetes|--docker]
                           crée un devzone dans <dossier> puis le lance ;
                           GitOps repository for Argo CD: github, or a URL, or none
                           --kubernetes: workspace in the cluster (default when it answers;
                           fails with nothing created without one)
                           --docker: deprecated Docker workstation, no cluster check
                           (without a cluster nothing is created, no silent Docker)
  devzone update [--yes] [--sans-reconstruire]
                           dans un dossier devzone : passe à la version du paquet
                           (sauvegarde les fichiers remplacés, propose make rebuild)
  devzone uninstall        dans un dossier devzone : retire conteneur, image, volumes
                           (à lancer avant npm uninstall -g devzone)
  devzone workspace start|stop|status|shell|update
  devzone workspace vscode|copy-to|copy-from|clone|migrate|revert|clean-docker
                           poste Kubernetes : pilote le chart devzone-workspace
  devzone workspace services enable|disable <service>|status
                           services (gitlab, postgres, argocd) du workspace Kubernetes
  devzone workspace argocd status|init|apply|app add|list|remove
                           Argo CD du workspace : dépôt GitOps, .argocd.conf, projets
  (anciens noms français : refusés avec le nouveau nom, voir README, « Noms retirés »)
  devzone --version
EOT
}

# Container commands (#471): a fixed list, to keep aligned with the final case
# of .devcontainer/devzone (consistency test in manage/test/cli.bats)
container_command() {
    case "$1" in
        ai | agent | apply | argocd | build | catalog | cluster | clusters | disable | \
            enable | gitlab | is-enabled | llm | metrics | modules | mysql | packages | \
            passwords | platform | port | postgres | repair | start | status | \
            test-bash32 | test-gitlab | ticket | use) return 0 ;;
        *) return 1 ;;
    esac
}

# Renamed names (#695): the French names of the host and container commands are
# refused before anything is created (« devzone mettre-a-jour » must not create a
# folder; « devzone stop » still creates ./stop). A copied devzone may miss the
# aliases file: then no check.
# shellcheck source=SCRIPTDIR/../.devcontainer/command-aliases.sh
# shellcheck disable=SC1091
if [ -f "$PAQUET/.devcontainer/command-aliases.sh" ]; then
    . "$PAQUET/.devcontainer/command-aliases.sh"
    reject_renamed "$@" || exit 1
fi


case "${1:-}" in
    "" | -h | --help | help) show_help ;;
    -v | --version) version ;;
    update)
        # shellcheck source=SCRIPTDIR/scripts/devzone-manifest.sh
        . "$PAQUET/manage/scripts/devzone-manifest.sh"
        # shellcheck source=SCRIPTDIR/scripts/devzone-update.sh
        . "$PAQUET/manage/scripts/devzone-update.sh"
        update_workstation "${@:2}"
        ;;
    uninstall)
        # Devzone folder (.devcontainer/); an older devzone has its uninstall.sh
        # in manage/scripts/ (new), core/scripts or scripts/ (old), or at the root
        uninstaller=""
        if [ -d .devcontainer ]; then
            for f in manage/scripts/uninstall.sh core/scripts/uninstall.sh scripts/uninstall.sh uninstall.sh; do
                if [ -f "$f" ]; then uninstaller="$f" && break; fi
            done
        fi
        if [ -z "$uninstaller" ]; then
            echo "✖ À lancer dans un dossier devzone (uninstall.sh introuvable ici)." >&2
            exit 1
        fi
        DEVZONE_COMMAND="devzone uninstall" bash "$uninstaller"
        ;;
    workspace)
        bash "$PAQUET/manage/workspace.sh" "${@:2}"
        ;;
    -*)
        echo "✖ option inconnue : $1 (devzone --help)" >&2
        exit 1
        ;;
    *)
        if container_command "$1"; then
            echo "✖ devzone $1 : commande du conteneur ; lance-la dans devzone (make shell), ou choisis un autre nom de dossier" >&2
            exit 2
        fi
        # shellcheck source=SCRIPTDIR/scripts/devzone-manifest.sh
        . "$PAQUET/manage/scripts/devzone-manifest.sh"
        # shellcheck source=SCRIPTDIR/scripts/devzone-create.sh
        . "$PAQUET/manage/scripts/devzone-create.sh"
        create_workstation "$1" "${@:2}"
        ;;
esac
