#!/usr/bin/env bash
# devzone command on your machine (npm package):
#   devzone <folder>         creates a devzone in <folder>, then starts it
#   devzone update           in a devzone folder: moves to the package version
#   devzone uninstall        in a devzone folder: removes everything it created
#   devzone --version | --help
# In the container, « devzone » is another command: the modules
# (.devcontainer/devzone).
# DEVZONE_NO_START=1: copy only, without starting the container (tests).
# The helpers live in manage/scripts/devzone-*.sh, sourced by the command that
# needs them (so --version and --help work with this file alone).
# shellcheck disable=SC2034 # PACKAGE_ITEMS, GITIGNORE_LINES: read by the sourced devzone-*.sh
set -euo pipefail

# Script path. From cmd, the npm .cmd shim calls bash with the Windows path
# (C:\…\bin\devzone): without "/", dirname/readlink would give "." and PAQUET
# would be wrong. We normalize first (cygpath from Git Bash, else \ → /);
# macOS/Linux: POSIX path, unchanged.
SCRIPT="${BASH_SOURCE[0]}"
case "$SCRIPT" in
    [A-Za-z]:[\\/]*) SCRIPT="$(cygpath -u "$SCRIPT" 2>/dev/null || echo "${SCRIPT//\\//}")" ;;
esac
PAQUET="$(cd "$(dirname "$(readlink -f "$SCRIPT" 2>/dev/null || echo "$SCRIPT")")/.." && pwd)"
# Items copied into a devzone (same list as the « files » of package.json,
# without the command manage/devzone); manage/scripts is copied apart, under manage/
PACKAGE_ITEMS=(.devcontainer Makefile .gitattributes README.md LICENSE)
# Lines always present in the .gitignore of a devzone: added to, never overwritten
GITIGNORE_LINES=(
    '# Each workspace project has its own git repository'
    'workspace/*'
    '!workspace/.gitkeep'
    '.DS_Store'
    '.devzone.log'
    '.devzone.state'
    '.password'
    '.devzone.backup/'
)

# Version of the package (package.json next to manage/)
version() {
    # Path passed as an argument to node, never written in the JavaScript code of -p:
    # under Git Bash $PAQUET is /c/… and only a separate argument is converted
    # for a Windows program (cygpath not needed)
    node -p 'require(process.argv[1]).version' "$PAQUET/package.json" 2>/dev/null || echo inconnue
}

# Go binary of the package (#773). bin/devzone-<os>-<arch>[.exe] is built by
# prepack (manage/scripts/ci/build-binaries.sh) and listed with its SHA-256 in
# bin/SHA256SUMS. When one exists for this machine, it is checked, copied once
# into ${XDG_CACHE_HOME:-~/.cache}/devzone/bin/<version>/ (npm drops the
# executable bit of the files outside "bin"; the copy is atomic) and run in
# place of this script. Any problem, DEVZONE_NO_GO or DEVZONE_FROM_GO (set by the
# Go binary when it delegates to this script: no loop) keeps the bash command.
go_platform() {
    local os arch
    case "$(uname -s 2>/dev/null)" in
        Linux) os=linux ;;
        Darwin) os=darwin ;;
        MINGW* | MSYS* | CYGWIN*) os=windows ;;
        *) return 1 ;;
    esac
    case "$(uname -m 2>/dev/null)" in
        x86_64 | amd64) arch=amd64 ;;
        arm64 | aarch64) arch=arm64 ;;
        *) return 1 ;;
    esac
    echo "$os-$arch"
}

# SHA-256 of file $1; node when neither sha256sum nor shasum exists
go_sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d' ' -f1
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | cut -d' ' -f1
    else
        node -e 'const h = require("crypto").createHash("sha256"); h.update(require("fs").readFileSync(process.argv[1])); console.log(h.digest("hex"))' "$1"
    fi
}

# Sum of file $2 in the SHA256SUMS file $1 (lines: "<sum>  <name>")
go_listed_sum() {
    local sum name
    [ -f "$1" ] || return 1
    while read -r sum name; do
        if [ "${name#\*}" = "$2" ]; then
            echo "$sum"
            return 0
        fi
    done <"$1"
    return 1
}

# Copies binary $1 to $2 (mode 755), then writes its sum $3 in $2.sha256: each
# step goes through a temporary file and mv, so a launch in parallel or a
# crash never leaves a half-written binary
go_install() {
    local tmp
    mkdir -p "$(dirname "$2")" || return 1
    tmp="$(mktemp "$2.XXXXXX")" || return 1
    if cp "$1" "$tmp" && chmod 755 "$tmp" && mv -f "$tmp" "$2" \
        && printf '%s\n' "$3" >"$tmp" && mv -f "$tmp" "$2.sha256"; then
        return 0
    fi
    rm -f "$tmp"
    return 1
}

# Runs the Go binary when it applies (never returns then); otherwise returns
go_launch() {
    local platform ext="" name bin want have ver base target
    if [ -n "${DEVZONE_NO_GO:-}" ] || [ -n "${DEVZONE_FROM_GO:-}" ]; then return 0; fi
    platform="$(go_platform)" || return 0
    case "$platform" in windows-*) ext=.exe ;; esac
    name="devzone-$platform$ext"
    bin="$PAQUET/bin/$name"
    [ -f "$bin" ] || return 0
    ver="$(version)"
    [ "$ver" != inconnue ] || return 0
    base="${XDG_CACHE_HOME:-}"
    if [ -z "$base" ] && [ -n "${HOME:-}" ]; then base="$HOME/.cache"; fi
    [ -n "$base" ] || return 0
    target="$base/devzone/bin/$ver/devzone$ext"
    want="$(go_listed_sum "$PAQUET/bin/SHA256SUMS" "$name")" || {
        echo "devzone: no checksum for $name in bin/SHA256SUMS, using the bash command" >&2
        return 0
    }
    if ! { [ -x "$target" ] && [ "$(cat "$target.sha256" 2>/dev/null)" = "$want" ]; }; then
        have="$(go_sha256 "$bin")" || have=""
        if [ "$have" != "$want" ]; then
            echo "devzone: checksum of $name does not match bin/SHA256SUMS, using the bash command" >&2
            return 0
        fi
        go_install "$bin" "$target" "$want" || {
            echo "devzone: cannot copy $name to $target, using the bash command" >&2
            return 0
        }
    fi
    # The Go binary finds the bash command (and the package.json) from here, even
    # copied into the cache; Git Bash gives it a Windows path
    DEVZONE_BASH_ENTRY="$PAQUET/manage/devzone"
    case "$platform" in
        windows-*) DEVZONE_BASH_ENTRY="$(cygpath -m "$DEVZONE_BASH_ENTRY" 2>/dev/null || echo "$DEVZONE_BASH_ENTRY")" ;;
    esac
    export DEVZONE_BASH_ENTRY
    exec "$target" "$@"
}

show_help() {
    cat <<EOT
devzone $(version): development workspace in a Kubernetes cluster

  devzone <folder> [--gitops github|none|<url>] [--kubernetes]
                           creates a devzone in <folder> (package files, .argocd.conf,
                           .devzone.modules), then starts its workspace in the cluster;
                           a folder that is not empty is refused
                           GitOps repository for Argo CD: github, or a URL, or none
                           --kubernetes: workspace in the cluster (default when it answers;
                           fails with nothing created without one)
  devzone update [--yes]
                           in a devzone folder: replaces the package files with those of
                           the installed package, after backing up the replaced files in
                           .devzone.backup/ (the new image is used at the next workspace start)
  devzone uninstall [--yes]
                           in a devzone folder: removes Kubernetes objects of this devzone
                           instance (namespaces, Argo CD Applications, temporary accounts,
                           .devzone.* files); workspace/ is kept; asks for confirmation
  devzone workspace start|stop|status|shell|update|deploy
  devzone workspace vscode|copy-to|copy-from|clone
                           Kubernetes workspace: drives the devzone-workspace chart
                           (start installs it, stop removes it from the cluster)
  devzone workspace services enable|disable <service>|status
                           services (gitlab, postgres, argocd) of the Kubernetes workspace
  devzone workspace ports enable|disable
                           automatic start of the port watcher on the workstation
  devzone workspace argocd status|init|apply|app add|list|remove
                           Argo CD of the workspace: GitOps repository, .argocd.conf, projects
  devzone --version
EOT
}

# Container commands (#471): a fixed list, to keep aligned with the final case
# of .devcontainer/devzone (consistency test in manage/test/cli.bats)
container_command() {
    case "$1" in
        ai | agent | apply | argocd | build | catalog | catalog-watcher | cluster | clusters | disable | \
            enable | gitlab | is-enabled | llm | metrics | modules | mysql | packages | \
            passwords | platform | port | postgres | repair | start | state | status | \
            test-bash32 | test-gitlab | ticket | use) return 0 ;;
        *) return 1 ;;
    esac
}

go_launch "$@"

case "${1:-}" in
    "" | -h | --help | help) show_help ;;
    -v | --version) version ;;
    update)
        # shellcheck source=SCRIPTDIR/scripts/devzone-manifest.sh
        . "$PAQUET/manage/scripts/devzone-manifest.sh"
        # shellcheck source=SCRIPTDIR/scripts/devzone-update.sh
        . "$PAQUET/manage/scripts/devzone-update.sh"
        update_workstation "${@:2}"
        ;;
    uninstall)
        # Devzone folder (.devcontainer/); an older devzone has its uninstall.sh
        # in manage/scripts/ (new), core/scripts or scripts/ (old), or at the root
        uninstaller=""
        if [ -d .devcontainer ]; then
            for f in manage/scripts/uninstall.sh core/scripts/uninstall.sh scripts/uninstall.sh uninstall.sh; do
                if [ -f "$f" ]; then uninstaller="$f" && break; fi
            done
        fi
        if [ -z "$uninstaller" ]; then
            echo "✖ Run this in a devzone folder (uninstall.sh not found here)." >&2
            exit 1
        fi
        DEVZONE_COMMAND="devzone uninstall" bash "$uninstaller"
        ;;
    workspace)
        bash "$PAQUET/manage/workspace.sh" "${@:2}"
        ;;
    -*)
        echo "✖ option inconnue : $1 (devzone --help)" >&2
        exit 1
        ;;
    *)
        if container_command "$1"; then
            echo "✖ devzone $1: pod command; run it in the pod (make shell), or choose another folder name" >&2
            exit 2
        fi
        # shellcheck source=SCRIPTDIR/scripts/devzone-manifest.sh
        . "$PAQUET/manage/scripts/devzone-manifest.sh"
        # shellcheck source=SCRIPTDIR/scripts/devzone-create.sh
        . "$PAQUET/manage/scripts/devzone-create.sh"
        create_workstation "$1" "${@:2}"
        ;;
esac
