#!/usr/bin/env bats
# Grouped credentials (#332): dummy sources under $BATS_TEST_TMPDIR,
# regeneration, format, mode, removal of accounts and the devzone command.
# No real secret file is read.

setup() {
    load commun
    DEVZONE="$BATS_TEST_DIRNAME/../../.devcontainer/devzone"
    PASSWORD="$BATS_TEST_DIRNAME/../../.devcontainer/password.sh"
    relais_docker_isole
    kube_isole
    export HOME="$BATS_TEST_TMPDIR/home"
    export DEVZONE_ROOT="$BATS_TEST_TMPDIR/racine"
    # startup.sh starts the automatic port watcher: its folder stays under the test (#394)
    export DEVZONE_PORTS_AUTO_DIR="$BATS_TEST_TMPDIR/ports-auto"
    ROOT="$DEVZONE_ROOT"
    GL="$ROOT/workspace/.gitlab"
    PG="$ROOT/workspace/.postgres"
    mkdir -p "$HOME" "$GL" "$PG"
    printf '%s' 'mdp-test-root' >"$GL/root-password"
    printf '%s' 'mdp-test-dev' >"$GL/dev-password"
    printf '%s' 'mdp-test-admin' >"$PG/admin-password"
    printf 'DB_NAME=alpha\nDB_USER=alpha_user\nDB_PASSWORD=mdp-test-alpha\n' >"$PG/alpha.env"
    printf 'DB_NAME=zeta\nDB_USER=zeta_user\nDB_PASSWORD=mdp-test-zeta\n' >"$PG/zeta.env"
}

@test "password: contents, header, tabs and sort by service then user" {
    run bash "$PASSWORD" regenerer
    [ "$status" -eq 0 ]
    [ "$output" = "" ]

    expected="$BATS_TEST_TMPDIR/expected"
    {
        printf '%s\n' \
            '# devzone : identifiers of the accounts created by devzone. Plain-text secrets:' \
            '# never commit, copy or paste them into a ticket. Regenerated by devzone.' \
            $'# service\taddress\tuser\tpassword' \
            $'gitlab\thttp://gitlab.localhost:8929\tdev\tmdp-test-dev' \
            $'gitlab\thttp://gitlab.localhost:8929\troot\tmdp-test-root' \
            $'postgres\t127.0.0.1:5432\tpostgres\tmdp-test-admin' \
            $'postgres:alpha\t127.0.0.1:5432/alpha\talpha_user\tmdp-test-alpha' \
            $'postgres:zeta\t127.0.0.1:5432/zeta\tzeta_user\tmdp-test-zeta'
    } >"$expected"
    diff -u "$expected" "$ROOT/.password"
    [ "$(awk -F'\t' '!/^#/ && NF != 4 { n++ } END { print n + 0 }' "$ROOT/.password")" -eq 0 ]
}

@test "password: mode 600" {
    bash "$PASSWORD" regenerer
    [ "$(stat -c %a "$ROOT/.password" 2>/dev/null || stat -f %Lp "$ROOT/.password")" = 600 ]
}

@test "password: line removed when an account disappears" {
    bash "$PASSWORD" regenerer
    rm -f "$GL/dev-password"
    run bash "$PASSWORD" regenerer
    [ "$status" -eq 0 ]
    ! grep -q $'^gitlab\t.*\tdev\t' "$ROOT/.password" || false
    grep -q $'^gitlab\thttp://gitlab.localhost:8929\troot\tmdp-test-root$' "$ROOT/.password"
}

@test "password: file removed when no account is left" {
    bash "$PASSWORD" regenerer
    [ -f "$ROOT/.password" ]
    rm -rf "$GL" "$PG"
    run bash "$PASSWORD" regenerer
    [ "$status" -eq 0 ]
    [ ! -e "$ROOT/.password" ]
}

@test "password chemin: prints the path, even without file" {
    run bash "$PASSWORD" chemin
    [ "$status" -eq 0 ]
    [ "$output" = "$ROOT/.password" ]
    [ ! -e "$ROOT/.password" ]
}

@test "devzone passwords: regenerates and prints only the path" {
    run bash "$DEVZONE" passwords
    [ "$status" -eq 0 ]
    [ "$output" = "$ROOT/.password" ]
    [[ "$output" != *mdp-test-* ]] || false
    [ -f "$ROOT/.password" ]
}

@test ".gitignore: .password ignored by git" {
    run git -C "$BATS_TEST_DIRNAME/../.." check-ignore --no-index .password
    [ "$status" -eq 0 ]
    [ "$output" = ".password" ]
}

@test "password: workspace/.<app>/*.env lists each application (MYSQL_* keys for mysql)" {
    mkdir -p "$ROOT/workspace/.mysql"
    printf 'MYSQL_HOST=127.0.0.1\nMYSQL_PORT=3306\nMYSQL_USER=datayer\nMYSQL_PASSWORD=mdp-datayer\n' >"$ROOT/workspace/.mysql/datayer.env"
    printf 'MYSQL_HOST=127.0.0.1\nMYSQL_PORT=3306\nMYSQL_USER=root\nMYSQL_PASSWORD=mdproot\n' >"$ROOT/workspace/.mysql/root.env"
    run bash "$PASSWORD" regenerer
    [ "$status" -eq 0 ] || false
    [ "$output" = "" ] || false
    grep -q $'^mysql:datayer\t127.0.0.1:3306\tdatayer\tmdp-datayer$' "$ROOT/.password" || false
    grep -q $'^mysql:root\t127.0.0.1:3306\troot\tmdproot$' "$ROOT/.password" || false
}

@test "startup: calls password.sh regenerer before the summary" {
    local startup="$BATS_TEST_DIRNAME/../../.devcontainer/startup.sh"
    local line_password line_summary
    line_password="$(grep -n 'bash "$ICI/password.sh" regenerer' "$startup" | cut -d: -f1)"
    line_summary="$(grep -n '^bash "$ICI/devzone"$' "$startup" | cut -d: -f1)"
    [ -n "$line_password" ]
    [ -n "$line_summary" ]
    [ "$line_password" -lt "$line_summary" ]
}
