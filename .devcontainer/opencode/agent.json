{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "git commit*": "allow",
      "git push*": "deny",
      "git checkout*": "deny",
      "git reset*": "deny",
      "git restore*": "deny",
      "git stash*": "deny",
      "git clean*": "deny",
      "git branch -D*": "deny",
      "repowarden *": "allow",
      "repowarden ticket nouveau*": "deny",
      "repowarden ticket label*": "deny",
      "repowarden ticket comment*": "deny",
      "repowarden ticket [0-9]*": "deny",
      "repowarden pr label*": "deny",
      "repowarden proteger*": "deny",
      "repowarden run*": "deny",
      "gh issue*": "deny",
      "gh pr*": "deny",
      "gh run*": "deny",
      "gh api*": "deny",
      "gh workflow*": "deny",
      "gh release*": "deny",
      "gh issue view*": "allow",
      "gh issue list*": "allow",
      "gh pr view*": "allow",
      "gh pr list*": "allow",
      "gh pr checks*": "allow",
      "gh pr diff*": "allow",
      "gh run view*": "allow",
      "gh run list*": "allow",
      "gh repo view*": "allow",
      "gh search*": "allow",
      "rm -rf*": "deny",
      "rm -rf ./.essai*": "allow",
      "rm -rf .essai*": "allow",
      "curl*": "deny",
      "wget*": "deny",
      "nc *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "sudo*": "deny",
      "gh auth token*": "deny",
      "gh auth status --show-token*": "deny",
      "*hosts.yml*": "deny",
      "*.credentials*": "deny",
      "*auth.json*": "deny",
      "*/.ssh/*": "deny",
      "env": "deny",
      "env *": "deny",
      "printenv*": "deny",
      "set": "deny",
      "export -p*": "deny",
      "ln *bash32*": "deny",
      "cp *bash32*": "deny",
      "mv *bash32*": "deny",
      "rm *bash32*": "deny",
      "chmod *bash32*": "deny",
      "install *bash32*": "deny"
    }
  }
}
