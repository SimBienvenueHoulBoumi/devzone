#!/usr/bin/env bash
# Aide de devzone (devzone --help) : .devcontainer/help.sh, sourcé ci-dessous.
#
# État propre à chaque instance : $RACINE/.devzone.modules (dossier monté
# de l'hôte, survit aux rebuilds), une ligne « module=on|off » ; la plateforme
# choisie y est gardée aussi (plateforme=, gitlab_url=), et le cluster des
# services (cluster=, voir cluster.sh) ; l'ancien état
# global (~/.config/devzone/modules) est repris une fois
set -euo pipefail

# Dossier du script, liens symboliques suivis à la main : readlink -f n'existe
# pas sur macOS (tests sous bash 3.2).
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    case "$SOURCE" in
        /*) ;;
        *) SOURCE="$DIR/$SOURCE" ;;
    esac
done
ICI="$(cd -P "$(dirname "$SOURCE")" && pwd)"
# shellcheck source=SCRIPTDIR/help.sh
# shellcheck disable=SC1091
. "$ICI/help.sh"
VERSIONS="$ICI/../manage/scripts/versions.sh"
# Dossier de devzone (/workspaces/devzone) ; DEVZONE_RACINE pour les tests
RACINE="${DEVZONE_RACINE:-$(dirname "$ICI")}"
# État par défaut de l'instance ; DEVZONE_ETAT garde la priorité (tests, CI)
ETAT="${DEVZONE_ETAT:-$RACINE/.devzone.modules}"
MODULES=(ia kubernetes gitlab postgres argocd mysql)
# shellcheck source=SCRIPTDIR/cluster.sh
# shellcheck disable=SC1091
. "$ICI/cluster.sh"
# English command names are accepted (#502); a copied devzone may miss the file
# shellcheck source=SCRIPTDIR/command-aliases.sh
# shellcheck disable=SC1091
if [ -f "$ICI/command-aliases.sh" ]; then
    . "$ICI/command-aliases.sh"
fi
# .argocd.conf of the instance: the GitOps repository designation (#539)
# shellcheck source=SCRIPTDIR/argocd/conf.sh
# shellcheck disable=SC1091
# shellcheck disable=SC2034 # read by conf.sh
if [ -f "$ICI/argocd/conf.sh" ]; then
    ARGOCD_CONF="$RACINE/.argocd.conf"
    . "$ICI/argocd/conf.sh"
fi
# GitOps repository line in the Kubernetes workspace pod (#639)
# shellcheck source=SCRIPTDIR/state-gitops.sh
# shellcheck disable=SC1091
. "$ICI/state-gitops.sh"
# Detection of the host (Ollama) models and the devzone-host opencode provider (#665).
# shellcheck source=SCRIPTDIR/ai/host-models.sh
# shellcheck disable=SC1091
. "$ICI/ai/host-models.sh"
# Update check and report for the host (Ollama) models (#668).
# shellcheck source=SCRIPTDIR/ai/host-check.sh
# shellcheck disable=SC1091
. "$ICI/ai/host-check.sh"

# Assistants IA, versions figées : mettre à jour ici, puis devzone apply
# (ou Rebuild Container). Une ligne par paquet, séparées par une ligne qui ne
# change pas : deux montées simultanées (workflow versions) se fusionnent sans
# conflit, git n'en signalant qu'entre lignes voisines modifiées.
# Claude Code
IA_CLAUDE=@anthropic-ai/claude-code@2.1.329
# opencode
IA_OPENCODE=opencode-ai@1.19.6
IA_PAQUETS=("$IA_CLAUDE" "$IA_OPENCODE")
IA_NOMS=("${IA_CLAUDE%@*}" "${IA_OPENCODE%@*}")

# glab (CLI GitLab), installé seulement quand la plateforme gitlab est
# choisie : binaire de la release officielle (gitlab.com/gitlab-org/cli)
# dans ~/.local/bin, somme SHA-256 de son archive vérifiée ; retiré au
# retour à github. Tous ses appels passent par ce chemin (jamais le PATH :
# ~/.local/bin n'y est pas forcément) ; l'état et la connexion aussi.
GLAB="$HOME/.local/bin/glab"
GLAB_VERSION=v1.126.0
GLAB_SOMME_ARM64=de5e92c9c8b306eeebb19daa854d48101b78328850e7b9cd677ecd6f98cd4391
GLAB_SOMME_AMD64=f386519ba83e9482979992ee7f60eeebee4d95b950f95f4fe7289e0a1b1ea74c
# Instance du module gitlab : son URL d'office et le jeton root de son seed
GITLAB_URL_MODULE=http://gitlab.localhost:8929

# Functions of devzone, by topic (sourced here, defined before any command runs)
# shellcheck source=SCRIPTDIR/devzone-modules.sh
# shellcheck disable=SC1091
. "$ICI/devzone-modules.sh"
# shellcheck source=SCRIPTDIR/devzone-ai.sh
# shellcheck disable=SC1091
. "$ICI/devzone-ai.sh"
# shellcheck source=SCRIPTDIR/devzone-ai-guard.sh
# shellcheck disable=SC1091
. "$ICI/devzone-ai-guard.sh"
# shellcheck source=SCRIPTDIR/devzone-skill.sh
# shellcheck disable=SC1091
. "$ICI/devzone-skill.sh"
# shellcheck source=SCRIPTDIR/devzone-services.sh
# shellcheck disable=SC1091
. "$ICI/devzone-services.sh"
# shellcheck source=SCRIPTDIR/devzone-cluster.sh
# shellcheck disable=SC1091
. "$ICI/devzone-cluster.sh"
# shellcheck source=SCRIPTDIR/devzone-repair.sh
# shellcheck disable=SC1091
. "$ICI/devzone-repair.sh"
# shellcheck source=SCRIPTDIR/devzone-platform.sh
# shellcheck disable=SC1091
. "$ICI/devzone-platform.sh"
# shellcheck source=SCRIPTDIR/devzone-version.sh
# shellcheck disable=SC1091
. "$ICI/devzone-version.sh"
# shellcheck source=SCRIPTDIR/devzone-status.sh
# shellcheck disable=SC1091
. "$ICI/devzone-status.sh"

# shellcheck source=state-json.sh
# shellcheck disable=SC1091
if [ -f "$ICI/state-json.sh" ]; then
    . "$ICI/state-json.sh"
fi

# Renamed names (#695): an old French name is refused with its new name, before
# anything runs (exit 1). Without the aliases file (copied devzone): no check.
if command -v reject_renamed >/dev/null 2>&1; then
    reject_renamed "$@" || exit 1
fi

case "${1:-}" in
    "" | status | modules) if [ "${2:-}" = "--json" ]; then state_json; else etat; fi ;;
    enable) changer on "${2:-}" "${@:3}" ;;
    disable) changer off "${2:-}" "${@:3}" ;;
    apply)
        migrer_llm
        # L'utilisateur confirme l'état courant (#417, étape 4) : les
        # veilleurs peuvent de nouveau désinstaller
        state_recovery_confirm
        appliquer_repowarden
        [ "$(valeur ia)" = off ] || appliquer_ia on
        # gitlab, postgres, argocd: installed from the workstation in the
        # Kubernetes workspace pod (#528), by their installer elsewhere
        [ "$(valeur gitlab)" = off ] || appliquer_service gitlab
        [ "$(valeur postgres)" = off ] || appliquer_service postgres
        [ "$(valeur mysql)" = off ] || appliquer_mysql on
        [ "$(valeur argocd)" = off ] || appliquer_service argocd
        ;;
    is-enabled)
        connu "${2:-}" || { echo "devzone : module inconnu : ${2:-(aucun)}" >&2; exit 2; }
        # Test silencieux, appelé par les scripts de démarrage : code 0 si le
        # module est actif, 1 sinon, sans rien écrire (kube-config.sh:16)
        [ "$(valeur "$2")" = on ]
        ;;
    agent)
        bash "$ICI/agent.sh" "${@:2}"
        ;;
    ai)
        case "${2:-}" in
            check)
                # Read-only: update state of each detected host model (#668).
                check
                ;;
            rapport)
                # Read-only: sizes, update state, measurements, chosen model (#668).
                rapport
                ;;
            *)
                # Read-only: lists the host (Ollama) models detected and the default model.
                liste="$(modeles)"
                def="$(premier)"
                if [ -z "$liste" ]; then
                    echo "devzone : aucun modèle Ollama détecté sur ${URL} (répondez sur /api/tags)"
                else
                    echo "devzone : modèles détectés sur l'hôte (Ollama) :"
                    while IFS= read -r m; do
                        [ -n "$m" ] && printf '  %s\n' "$m"
                    done <<<"$liste"
                    echo "modèle par défaut : ${def:-aucun}"
                fi
                ;;
        esac
        ;;
    ticket) bash "$ICI/ticket.sh" "${@:2}" ;;
    build)
        bash "$ICI/workspace-build.sh" "${@:2}"
        ;;
    repair) reparer ;;
    start) bash "$ICI/startup.sh" ;;
    metrics) bash "$ICI/metrics-server.sh" "${@:2}" ;;
    use) utiliser "${@:2}" ;;
    clusters) DEVZONE_ETAT="$ETAT" bash "$ICI/clusters.sh" "${@:2}" ;;
    cluster) changer_cluster "${@:2}" ;;
    postgres) DEVZONE_ETAT="$ETAT" bash "$ICI/postgres/postgres.sh" "${@:2}" ;;
    mysql) DEVZONE_ETAT="$ETAT" bash "$ICI/catalog/mysql/mysql.sh" "${@:2}" ;;
    gitlab) DEVZONE_ETAT="$ETAT" bash "$ICI/gitlab/gitlab.sh" "${@:2}" ;;
    catalog) DEVZONE_ETAT="$ETAT" bash "$ICI/catalog.sh" list ;;
    argocd) DEVZONE_ETAT="$ETAT" bash "$ICI/argocd/argocd.sh" "${@:2}" ;;
    port) DEVZONE_ETAT="$ETAT" bash "$ICI/ports.sh" "${@:2}" ;;
    packages) bash "$ICI/packages.sh" "${@:2}" ;;
    passwords)
        bash "$ICI/password.sh" regenerer ||
            echo "devzone : identifiants regroupés non mis à jour" >&2
        bash "$ICI/password.sh" chemin
        ;;
    -h | --help | help) devzone_aide ;;
    -v | --version) echo "devzone ${DEVZONE_VERSION:-unknown}" ;;
    test-bash32) bash "$RACINE/manage/test/bash32.sh" ;;
    test-gitlab) DEVZONE_ETAT="$ETAT" bash "$ICI/gitlab/test-gitlab.sh" "${@:2}" ;;
    platform)
        if [ -n "${2:-}" ]; then
            changer_plateforme "${@:2}"
        else
            resume_plateforme
        fi
        ;;
    *)
        echo "devzone : commande inconnue : $1 (devzone --help)" >&2
        exit 1
        ;;
esac
