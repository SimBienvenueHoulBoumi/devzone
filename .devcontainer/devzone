#!/usr/bin/env bash
# Modules facultatifs de devzone, activés à la demande, sans rebuild :
#   devzone                          état des modules
#   devzone activer <module>         active et applique tout de suite
#   devzone desactiver <module>      désactive et applique tout de suite
#   devzone appliquer                installe ce qui est actif (post-create.sh)
#   devzone actif <module>           code 0 si actif (scripts de démarrage)
# État propre à chaque utilisateur : ~/.config/devzone/modules (volume
# devzone-config, survit aux rebuilds), une ligne « module=on|off ».
set -euo pipefail

ETAT="${DEVZONE_ETAT:-$HOME/.config/devzone/modules}"
ICI="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
VERSIONS="$ICI/../core/scripts/versions.sh"
# Dossier de devzone (/workspaces/devzone) ; DEVZONE_RACINE pour les tests
RACINE="${DEVZONE_RACINE:-$(dirname "$ICI")}"
MODULES=(ia kubernetes)

# Assistants IA, versions figées : mettre à jour ici, puis devzone appliquer
# (ou Rebuild Container)
IA_PAQUETS=(@anthropic-ai/claude-code@2.1.310 opencode-ai@1.19.4)
IA_NOMS=(@anthropic-ai/claude-code opencode-ai)

description() {
    case "$1" in
        ia) echo "assistants IA : Claude Code, opencode" ;;
        kubernetes) echo "connexion au cluster de l'hôte et metrics-server au démarrage" ;;
    esac
}

connu() {
    local m
    for m in "${MODULES[@]}"; do [ "$m" = "$1" ] && return 0; done
    return 1
}

# Premier démarrage (aucun état) : tout désactivé, sauf ia si une connexion
# existe déjà dans les volumes (pas de régression pour qui s'en servait)
initialiser() {
    [ -f "$ETAT" ] && return 0
    mkdir -p "$(dirname "$ETAT")"
    local ia=off
    if [ -f "$HOME/.claude/.credentials.json" ] || [ -f "$HOME/.local/share/opencode/auth.json" ]; then
        ia=on
        # stderr : initialiser est aussi appelé dans $(valeur …)
        echo "devzone : connexion d'un assistant IA trouvée, module ia activé (devzone desactiver ia pour le retirer)" >&2
    fi
    printf 'ia=%s\nkubernetes=off\n' "$ia" >"$ETAT"
}

valeur() {
    initialiser
    local v
    v="$(grep -E "^$1=" "$ETAT" | tail -1 | cut -d= -f2 || true)"
    [ "$v" = on ] && echo on || echo off
}

ecrire() {
    initialiser
    local tmp
    tmp="$(mktemp)"
    grep -vE "^$1=" "$ETAT" >"$tmp" || true
    echo "$1=$2" >>"$tmp"
    mv "$tmp" "$ETAT"
}

# Vrai si le fichier ne contient que la clé $schema (créé d'office par opencode)
contient_seulement_schema() {
    local autres
    autres="$(grep -vcE '^[[:space:]]*([{}]|"?[$]schema"?[[:space:]]*:.*)?[[:space:]]*$' "$1" || true)"
    [ "$autres" -eq 0 ] && grep -qF "\$schema" "$1"
}

# Configuration opencode par défaut (modèle versionné) : écrite au premier
# usage, mise à jour tant qu'elle garde le repère devzone, personnalisée sinon.
config_opencode() {
    local modele="$ICI/opencode.jsonc" repere cible
    repere='// devzone : configuration opencode par défaut'
    if [ -f "$HOME/.config/opencode/opencode.jsonc" ]; then
        cible="$HOME/.config/opencode/opencode.jsonc"
    elif [ -f "$HOME/.config/opencode/opencode.json" ]; then
        cible="$HOME/.config/opencode/opencode.json"
    else
        cible="$HOME/.config/opencode/opencode.jsonc"
    fi
    mkdir -p "$(dirname "$cible")"
    if [ ! -f "$cible" ]; then
        cp "$modele" "$cible"
        echo "opencode : configuration par défaut écrite"
    elif grep -qF "$repere" "$cible"; then
        if ! cmp -s "$modele" "$cible"; then
            cp "$modele" "$cible"
            echo "opencode : configuration par défaut mise à jour"
        fi
    elif contient_seulement_schema "$cible"; then
        cp "$modele" "$cible"
        echo "opencode : configuration par défaut mise à jour"
    else
        echo "opencode : configuration personnalisée, gardée"
    fi
}

appliquer_ia() {
    if [ "$1" = on ]; then
        npm install -g --no-fund --no-audit --loglevel=error "${IA_PAQUETS[@]}" >/dev/null
        # Garde-fou repowarden (hook PreToolUse de Claude Code, plugin opencode) :
        # agent arrêté avant de modifier main/develop, de commiter sans
        # repowarden cc ou de contourner les hooks. Global, dans les volumes
        # ~/.claude et ~/.config/opencode : gardé aux rebuilds ; relancé, rien ne change
        if command -v repowarden >/dev/null 2>&1 && repowarden agents init --global >/dev/null 2>&1; then
            echo "devzone : garde-fou repowarden actif pour Claude Code et opencode"
        else
            echo "devzone : garde-fou repowarden non branché (repowarden 4.10 ou plus requis) : repowarden agents init --global" >&2
        fi
        config_opencode
        echo "devzone : ia actif : claude (puis /login), opencode auth login"
    else
        npm uninstall -g "${IA_NOMS[@]}" >/dev/null 2>&1 || true
        echo "devzone : ia désactivé (connexions gardées dans leurs volumes)"
    fi
}

appliquer_kubernetes() {
    if [ "$1" = on ]; then
        bash "$ICI/kube-config.sh"
    else
        rm -f "$HOME/.kube/hote.config"
        echo "devzone : kubernetes désactivé (metrics-server reste installé sur les clusters où il l'a été)"
    fi
}

# Lignes « paquet figée installée » des outils en retard ; échoue si le script
# versions.sh est absent ou ne peut pas répondre (l'état omet alors la ligne)
outils_retard() {
    [ -f "$VERSIONS" ] || return 1
    bash "$VERSIONS" --installees 2>/dev/null
}

# Remet repowarden à la version figée s'il en diffère, comme post-create.sh
# (il installe les hooks git globaux)
appliquer_repowarden() {
    local ligne figee installee
    [ -f "$VERSIONS" ] || return 0
    ligne="$(bash "$VERSIONS" --installees 2>/dev/null | awk '$1 == "repowarden"' || true)"
    [ -n "$ligne" ] || return 0
    read -r _ figee installee <<<"$ligne"
    npm install -g "repowarden@$figee" >/dev/null
    repowarden install --global --lang fr
    echo "devzone : repowarden $installee → $figee"
}

# Chemins des worktrees du dépôt devzone et des dépôts du workspace absents
# ici : créés de l'autre côté (hôte), un git worktree prune les casserait.
# Lecture seule : rien n'est supprimé ni réparé.
worktrees_absents() {
    local depot ligne chemin
    {
        [ -e "$RACINE/.git" ] && echo "$RACINE"
        find "$RACINE/workspace" -mindepth 2 -maxdepth 3 -name .git -type d 2>/dev/null | sed 's|/\.git$||'
    } | while IFS= read -r depot; do
        { git -C "$depot" worktree list --porcelain 2>/dev/null || true; } | while IFS= read -r ligne; do
            case "$ligne" in
                "worktree "*)
                    chemin="${ligne#worktree }"
                    [ -d "$chemin" ] || echo "$chemin"
                    ;;
            esac
        done
    done || true
}

# État complet : ✔ prêt, ✖ nécessaire, ○ facultatif, ⚠ à corriger ; chaque
# point à faire avec sa commande (affiché à chaque démarrage)
etat() {
    local nom email statut m retards chemin
    echo "devzone : état (devzone pour le réafficher)"
    nom="$(git config --get user.name || true)"
    email="$(git config --get user.email || true)"
    if [ -n "$nom" ] && [ -n "$email" ]; then
        echo "  ✔ identité git    $nom <$email>"
    else
        echo "  ✖ identité git    nécessaire pour commiter : gh auth login -s workflow (automatique),"
        echo "                    ou git config --file ~/.config/git/config user.name \"<nom>\" et user.email \"<email>\""
    fi
    if ! statut="$(gh auth status 2>&1)"; then
        echo "  ○ GitHub          facultatif (push et PR, tickets repowarden) : gh auth login -s workflow"
    elif grep -q "Token scopes:" <<<"$statut" && ! grep -q "'workflow'" <<<"$statut"; then
        echo "  ⚠ GitHub          connecté, sans permission workflow (push de .github/workflows/ refusé) : gh auth refresh -h github.com -s workflow"
    else
        echo "  ✔ GitHub          connecté"
    fi
    if retards="$(outils_retard)"; then
        if [ -z "$retards" ]; then
            echo "  ✔ outils          versions figées"
        else
            while read -r paquet figee installee; do
                [ -n "$paquet" ] || continue
                echo "  ⚠ outils          $paquet $installee installé, $figee figé : devzone appliquer"
            done <<<"$retards"
        fi
    fi
    while IFS= read -r chemin; do
        [ -n "$chemin" ] || continue
        echo "  ⚠ worktree        $chemin absent ici (créé hors du conteneur ?) : le gérer de ce côté-là, jamais git worktree prune ici (docs/reference.md, Worktrees git)"
    done < <(worktrees_absents)
    for m in "${MODULES[@]}"; do
        if [ "$(valeur "$m")" = on ]; then
            printf '  ✔ module %-10s actif : %s\n' "$m" "$(description "$m")"
        else
            printf '  ○ module %-10s facultatif, %s : devzone activer %s\n' "$m" "$(description "$m")" "$m"
        fi
    done
}

changer() {
    local m="${2:-}"
    if [ -z "$m" ] || ! connu "$m"; then
        echo "devzone : module inconnu : ${m:-(aucun)} ; modules : ${MODULES[*]}" >&2
        exit 1
    fi
    ecrire "$m" "$1"
    "appliquer_$m" "$1"
}

case "${1:-}" in
    "" | etat | modules) etat ;;
    activer) changer on "${2:-}" ;;
    desactiver) changer off "${2:-}" ;;
    appliquer)
        appliquer_repowarden
        [ "$(valeur ia)" = off ] || appliquer_ia on
        ;;
    actif)
        connu "${2:-}" || { echo "devzone : module inconnu : ${2:-(aucun)}" >&2; exit 2; }
        [ "$(valeur "$2")" = on ]
        ;;
    -h | --help | aide) sed -n '2,8p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
    *)
        echo "devzone : commande inconnue : $1 (devzone --help)" >&2
        exit 1
        ;;
esac
