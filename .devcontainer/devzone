#!/usr/bin/env bash
# shellcheck disable=SC2034 # shared variables, read by the sourced devzone-*.sh
# devzone help (devzone --help): .devcontainer/help.sh, sourced below.
#
# Per-instance state: $RACINE/.devzone.modules (a folder mounted from the host,
# survives rebuilds), one line "module=on|off"; the chosen platform is kept
# there too (platform=, gitlab_url=), and the services cluster (cluster=, see
# cluster.sh); the old global state (~/.config/devzone/modules) is read once
set -euo pipefail

# Script folder, symbolic links followed by hand: readlink -f does not exist
# on macOS (tests under bash 3.2).
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    case "$SOURCE" in
        /*) ;;
        *) SOURCE="$DIR/$SOURCE" ;;
    esac
done
ICI="$(cd -P "$(dirname "$SOURCE")" && pwd)"
# Go first (#754): a command ported to Go runs in the devzone-pod binary of the image.
# DEVZONE_NO_GO=1 forces the shell, DEVZONE_FROM_GO=1 avoids loops.
if [ -z "${DEVZONE_NO_GO:-}" ] && [ -z "${DEVZONE_FROM_GO:-}" ]; then
    case "$(uname -m)" in
        x86_64) POD_GO_ARCH=amd64 ;;
        aarch64 | arm64) POD_GO_ARCH=arm64 ;;
        *) POD_GO_ARCH="" ;;
    esac
    POD_GO="$ICI/bin/devzone-pod-linux-$POD_GO_ARCH"
    if [ -n "$POD_GO_ARCH" ] && [ -x "$POD_GO" ] && "$POD_GO" handles "${1:-}" >/dev/null 2>&1; then
        exec "$POD_GO" "$@"
    fi
fi
# shellcheck source=SCRIPTDIR/help.sh
# shellcheck disable=SC1091
. "$ICI/help.sh"
VERSIONS="$ICI/../manage/scripts/ci/versions.sh"
# devzone folder (/workspaces/devzone); DEVZONE_ROOT for the tests
RACINE="${DEVZONE_ROOT:-$(dirname "$ICI")}"
# Default state of the instance; DEVZONE_STATE takes precedence (tests, CI)
ETAT="${DEVZONE_STATE:-$RACINE/.devzone.modules}"
MODULES=(ai kubernetes gitlab postgres argocd mysql)
# shellcheck source=SCRIPTDIR/cluster.sh
# shellcheck disable=SC1091
. "$ICI/cluster.sh"
# English command names are accepted (#502); a copied devzone may miss the file
# shellcheck source=SCRIPTDIR/command-aliases.sh
# shellcheck disable=SC1091
if [ -f "$ICI/command-aliases.sh" ]; then
    . "$ICI/command-aliases.sh"
fi
# .argocd.conf of the instance: the GitOps repository designation (#539)
# shellcheck source=SCRIPTDIR/argocd/conf.sh
# shellcheck disable=SC1091
# shellcheck disable=SC2034 # read by conf.sh
if [ -f "$ICI/argocd/conf.sh" ]; then
    ARGOCD_CONF="$RACINE/.argocd.conf"
    . "$ICI/argocd/conf.sh"
fi
# GitOps repository line in the Kubernetes workspace pod (#639)
# shellcheck source=SCRIPTDIR/state-gitops.sh
# shellcheck disable=SC1091
. "$ICI/state-gitops.sh"
# Detection of the host (Ollama) models and the devzone-host opencode provider (#665).
# shellcheck source=SCRIPTDIR/ai/host-models.sh
# shellcheck disable=SC1091
. "$ICI/ai/host-models.sh"
# Update check and report for the host (Ollama) models (#668).
# shellcheck source=SCRIPTDIR/ai/host-check.sh
# shellcheck disable=SC1091
. "$ICI/ai/host-check.sh"

# AI assistants, pinned versions: update here, then devzone apply (or Rebuild
# Container). One line per package, separated by a line that does not change:
# two simultaneous bumps (versions workflow) merge without conflict, git only
# reporting neighbouring lines changed.
# Claude Code
IA_CLAUDE=@anthropic-ai/claude-code@2.1.330
# opencode
IA_OPENCODE=opencode-ai@1.19.6
IA_PAQUETS=("$IA_CLAUDE" "$IA_OPENCODE")
IA_NOMS=("${IA_CLAUDE%@*}" "${IA_OPENCODE%@*}")

# glab (GitLab CLI), installed only when the gitlab platform is chosen: binary
# of the official release (gitlab.com/gitlab-org/cli) in ~/.local/bin, SHA-256
# sum of its archive checked; removed when going back to github. All its calls
# go through this path (never PATH: ~/.local/bin is not necessarily in it); the
# state and the login too.
GLAB="$HOME/.local/bin/glab"
GLAB_VERSION=v1.126.0
GLAB_SOMME_ARM64=de5e92c9c8b306eeebb19daa854d48101b78328850e7b9cd677ecd6f98cd4391
GLAB_SOMME_AMD64=f386519ba83e9482979992ee7f60eeebee4d95b950f95f4fe7289e0a1b1ea74c
# gitlab module instance: its default URL and the root token of its seed
GITLAB_URL_MODULE=http://gitlab.localhost:8929

# Functions of devzone, by topic (sourced here, defined before any command runs)
# shellcheck source=SCRIPTDIR/devzone-modules.sh
# shellcheck disable=SC1091
. "$ICI/devzone-modules.sh"
# shellcheck source=SCRIPTDIR/devzone-ai.sh
# shellcheck disable=SC1091
. "$ICI/devzone-ai.sh"
# shellcheck source=SCRIPTDIR/devzone-ai-guard.sh
# shellcheck disable=SC1091
. "$ICI/devzone-ai-guard.sh"
# shellcheck source=SCRIPTDIR/devzone-skill.sh
# shellcheck disable=SC1091
. "$ICI/devzone-skill.sh"
# shellcheck source=SCRIPTDIR/devzone-services.sh
# shellcheck disable=SC1091
. "$ICI/devzone-services.sh"
# shellcheck source=SCRIPTDIR/devzone-cluster.sh
# shellcheck disable=SC1091
. "$ICI/devzone-cluster.sh"
# shellcheck source=SCRIPTDIR/devzone-repair.sh
# shellcheck disable=SC1091
. "$ICI/devzone-repair.sh"
# shellcheck source=SCRIPTDIR/devzone-platform.sh
# shellcheck disable=SC1091
. "$ICI/devzone-platform.sh"
# shellcheck source=SCRIPTDIR/devzone-version.sh
# shellcheck disable=SC1091
. "$ICI/devzone-version.sh"
# shellcheck source=SCRIPTDIR/devzone-status.sh
# shellcheck disable=SC1091
. "$ICI/devzone-status.sh"

# shellcheck source=state-json.sh
# shellcheck disable=SC1091
if [ -f "$ICI/state-json.sh" ]; then
    . "$ICI/state-json.sh"
fi

# Renamed names (#695): an old French name is refused with its new name, before
# anything runs (exit 1). Without the aliases file (copied devzone): no check.
if command -v reject_renamed >/dev/null 2>&1; then
    reject_renamed "$@" || exit 1
fi

case "${1:-}" in
    "" | status | modules) if [ "${2:-}" = "--json" ]; then state_json; else show_state; fi ;;
    enable) change_module on "${2:-}" "${@:3}" ;;
    disable) change_module off "${2:-}" "${@:3}" ;;
    apply)
        migrate_llm
        # The user confirms the current state (#417, step 4): the watchers
        # may uninstall again
        state_recovery_confirm
        apply_repowarden
        [ "$(value_of ai)" = off ] || apply_ai on
        # gitlab, postgres, argocd: installed from the workstation in the
        # Kubernetes workspace pod (#528), by their installer elsewhere
        [ "$(value_of gitlab)" = off ] || apply_service gitlab
        [ "$(value_of postgres)" = off ] || apply_service postgres
        [ "$(value_of mysql)" = off ] || apply_mysql on
        [ "$(value_of argocd)" = off ] || apply_service argocd
        ;;
    is-enabled)
        is_known "${2:-}" || { echo "devzone : unknown module : ${2:-(none)}" >&2; exit 2; }
        # Silent test, called by the startup scripts: code 0 if the module is
        # active, 1 otherwise, without writing anything (kube-config.sh:16)
        [ "$(value_of "$2")" = on ]
        ;;
    agent)
        bash "$ICI/agent.sh" "${@:2}"
        ;;
    ai)
        case "${2:-}" in
            check)
                # Read-only: update state of each detected host model (#668).
                check
                ;;
            rapport)
                # Read-only: sizes, update state, measurements, chosen model (#668).
                rapport
                ;;
            *)
                # Read-only: lists the host (Ollama) models detected and the default model.
                models_list="$(modeles)"
                default_model="$(premier)"
                if [ -z "$models_list" ]; then
                    echo "devzone : no Ollama model detected on ${URL} (answer on /api/tags)"
                else
                    echo "devzone : models detected on the host (Ollama):"
                    while IFS= read -r m; do
                        [ -n "$m" ] && printf '  %s\n' "$m"
                    done <<<"$models_list"
                    echo "default model: ${default_model:-none}"
                fi
                ;;
        esac
        ;;
    ticket) bash "$ICI/ticket.sh" "${@:2}" ;;
    build)
        bash "$ICI/workspace-build.sh" "${@:2}"
        ;;
    repair) repair_workstation ;;
    start) bash "$ICI/startup.sh" ;;
    metrics) bash "$ICI/metrics-server.sh" "${@:2}" ;;
    use) use_cluster "${@:2}" ;;
    clusters) DEVZONE_STATE="$ETAT" bash "$ICI/clusters.sh" "${@:2}" ;;
    cluster) change_cluster "${@:2}" ;;
    postgres) DEVZONE_STATE="$ETAT" bash "$ICI/postgres/postgres.sh" "${@:2}" ;;
    mysql) DEVZONE_STATE="$ETAT" bash "$ICI/catalog/mysql/mysql.sh" "${@:2}" ;;
    gitlab) DEVZONE_STATE="$ETAT" bash "$ICI/gitlab/gitlab.sh" "${@:2}" ;;
    catalog) DEVZONE_STATE="$ETAT" bash "$ICI/catalog.sh" list ;;
    argocd) DEVZONE_STATE="$ETAT" bash "$ICI/argocd/argocd.sh" "${@:2}" ;;
    port) DEVZONE_STATE="$ETAT" bash "$ICI/ports.sh" "${@:2}" ;;
    packages) bash "$ICI/packages.sh" "${@:2}" ;;
    passwords)
        bash "$ICI/password.sh" regenerer ||
            echo "devzone : grouped credentials not updated" >&2
        bash "$ICI/password.sh" chemin
        ;;
    -h | --help | help) devzone_aide ;;
    -v | --version) echo "devzone ${DEVZONE_VERSION:-unknown}" ;;
    test-bash32) bash "$RACINE/manage/test/bash32.sh" ;;
    test-gitlab) DEVZONE_STATE="$ETAT" bash "$ICI/gitlab/test-gitlab.sh" "${@:2}" ;;
    platform)
        if [ -n "${2:-}" ]; then
            change_platform "${@:2}"
        else
            platform_summary
        fi
        ;;
    *)
        echo "devzone : unknown command : $1 (devzone --help)" >&2
        exit 1
        ;;
esac
