# Single source for the repowarden version used by workspace-init.sh and manage/scripts/ci/versions.sh.
REPOWARDEN_VERSION=4.18.1

# BuildKit client version installed in the workspace image (#514). Must match
# buildkit.image in charts/devzone-workspace/values.yaml.
BUILDKIT_VERSION=0.34.2

# metrics-server, dependency of Argo CD: the official chart pinned here (3.14.0
# ships the application v0.9.0). Read by internal/domain/argocd and by
# metrics-server.sh; the two values move together.
METRICS_SERVER_CHART_VERSION=3.14.0
METRICS_SERVER_VERSION=v0.9.0
