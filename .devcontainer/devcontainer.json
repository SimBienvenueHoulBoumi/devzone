{
  "name": "devzone",
  // Image de base + outils figés (k9s, uv, actionlint, gitleaks…) : voir Dockerfile
  "build": { "dockerfile": "Dockerfile" },

  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "jdkDistro": "tem",
      "installMaven": true
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts",
      "pnpmVersion": "latest"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12",
      // Pas d'outils pipx : leur lanceur « python -E » ignore PYTHONPATH et
      // PYTHONPYCACHEPREFIX, dont repowarden a besoin pour lancer les tests
      // (ruff, vulture et pytest viennent du Dockerfile, par uv)
      "installTools": false
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "minikube": "none"
    },
    // gh : tickets, PR, protection (repowarden)
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Toujours /workspaces/devzone, quel que soit le nom du dossier sur l'hôte
  // (npx devzone <dossier>) : scripts et chemins du conteneur en dépendent
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/devzone,type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/devzone",

  // Caches persistants : survivent aux rebuilds du conteneur. Préfixe des
  // volumes : devzone, ou DEVZONE_VOLUMES (tests fonctionnels, isolés)
  "mounts": [
    "source=${localEnv:DEVZONE_VOLUMES:devzone}-m2,target=/home/vscode/.m2,type=volume",
    "source=${localEnv:DEVZONE_VOLUMES:devzone}-pnpm,target=/home/vscode/.local/share/pnpm,type=volume",
    // Assistants IA : connexion et réglages gardés d'un rebuild à l'autre
    "source=${localEnv:DEVZONE_VOLUMES:devzone}-claude,target=/home/vscode/.claude,type=volume",
    "source=${localEnv:DEVZONE_VOLUMES:devzone}-opencode-config,target=/home/vscode/.config/opencode,type=volume",
    "source=${localEnv:DEVZONE_VOLUMES:devzone}-opencode-data,target=/home/vscode/.local/share/opencode,type=volume",
    // Connexion gh et identité git (~/.config/git/config, lu par git comme
    // config globale) : le conteneur reconstruit peut commiter et pousser
    "source=${localEnv:DEVZONE_VOLUMES:devzone}-gh,target=/home/vscode/.config/gh,type=volume",
    "source=${localEnv:DEVZONE_VOLUMES:devzone}-git,target=/home/vscode/.config/git,type=volume",
    // Modules activés (devzone activer|desactiver) : état par instance
    // ($RACINE/.devzone.modules) ; ce volume garde l'ancien état utilisateur
    "source=${localEnv:DEVZONE_VOLUMES:devzone}-config,target=/home/vscode/.config/devzone,type=volume"
  ],

  "runArgs": [
    // Cluster Kubernetes de l'hôte : sa config en lecture seule, adaptée au
    // conteneur par kube-config.sh. HOME (Mac, Linux) ou USERPROFILE (Windows) ;
    // -v plutôt que mounts : crée ~/.kube s'il manque au lieu d'échouer
    "-v", "${localEnv:HOME}${localEnv:USERPROFILE}/.kube:/home/vscode/.kube-host:ro",
    // host.docker.internal existe d'office avec Docker Desktop, pas sous Linux
    "--add-host=host.docker.internal:host-gateway"
  ],

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  // Identité git, clusters, puis récapitulatif de ce qui reste à faire
  "postStartCommand": "bash .devcontainer/demarrage.sh",
  // Clusters kind du conteneur (config) + cluster de l'hôte (hote.config,
  // refait à chaque démarrage par kube-config.sh)
  "remoteEnv": {
    "KUBECONFIG": "/home/vscode/.kube/config:/home/vscode/.kube/hote.config",
    // Claude Code range aussi .claude.json (connexion, réglages) dans ce
    // dossier, donc dans son volume, au lieu de ~/.claude.json
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  "remoteUser": "vscode",

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-boot-dev-pack",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "redhat.vscode-yaml"
      ]
    }
  }
}
