// devzone : configuration opencode par défaut (devzone activer ia la tient à jour ; retirer cette ligne pour la personnaliser)
{
  "$schema": "https://opencode.ai/config.json",
  // Modèles gratuits de la version d'opencode fixée par devzone.
  // Partage et mises à jour désactivés : les versions sont fixées par devzone.
  "model": "opencode/big-pickle",
  "small_model": "opencode/mimo-v2.6-flash-free",
  "share": "disabled",
  "autoupdate": false,
  "compaction": {
    "auto": true
  },
  // Permissions strictes par défaut : ce qui sert au travail est permis sans
  // question, le reste demande ton accord (ask), et ce qui peut faire fuir un
  // secret est interdit (deny). Ordre important : le dernier motif qui
  // correspond l'emporte, donc garder « * » en tête, les allow ensuite et les
  // deny en dernier. Pour élargir : retirer la ligne repère en tête du fichier
  // (devzone le garde alors tel quel) puis ajouter un allow.
  "permission": {
    "edit": "allow",
    "webfetch": "ask",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "repowarden *": "allow",
      "gh issue view*": "allow",
      "gh issue list*": "allow",
      "gh pr view*": "allow",
      "gh pr list*": "allow",
      "gh pr checks*": "allow",
      "gh pr diff*": "allow",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "gh repo view*": "allow",
      "gh search*": "allow",
      "ls*": "allow",
      "cat*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "wc*": "allow",
      "grep*": "allow",
      "rg*": "allow",
      "find*": "allow",
      "tree*": "allow",
      "sed -n*": "allow",
      "awk*": "allow",
      "sort*": "allow",
      "uniq*": "allow",
      "cut*": "allow",
      "diff*": "allow",
      "jq*": "allow",
      "file*": "allow",
      "stat*": "allow",
      "pwd": "allow",
      "which*": "allow",
      "command -v*": "allow",
      "echo*": "allow",
      "printf*": "allow",
      "date*": "allow",
      "mkdir*": "allow",
      "touch*": "allow",
      "cp*": "allow",
      "mv*": "allow",
      "rm *": "allow",
      "chmod*": "allow",
      "ln*": "allow",
      "bats*": "allow",
      "shellcheck*": "allow",
      "actionlint*": "allow",
      "bash -n*": "allow",
      "npm test*": "allow",
      "npm run*": "allow",
      "npm ci*": "allow",
      "npm install*": "allow",
      "npx*": "allow",
      "pnpm*": "allow",
      "yarn*": "allow",
      "node*": "allow",
      "python*": "allow",
      "python3*": "allow",
      "pytest*": "allow",
      "pip install*": "allow",
      "uv*": "allow",
      "ruff*": "allow",
      "mvn*": "allow",
      "./mvnw*": "allow",
      "gradle*": "allow",
      "./gradlew*": "allow",
      "go *": "allow",
      "cargo *": "allow",
      "make*": "allow",
      "docker build*": "allow",
      "docker ps*": "allow",
      "kubectl get*": "allow",
      "helm template*": "allow",
      "terraform fmt*": "allow",
      "terraform validate*": "allow",
      "opencode models*": "allow",
      "devzone*": "allow",
      "gh auth token*": "deny",
      "gh auth status --show-token*": "deny",
      "*hosts.yml*": "deny",
      "*.credentials*": "deny",
      "*auth.json*": "deny",
      "*/.ssh/*": "deny",
      "env": "deny",
      "env *": "deny",
      "printenv*": "deny",
      "set": "deny",
      "export -p*": "deny",
      "curl*": "deny",
      "wget*": "deny",
      "nc *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "sudo*": "deny",
      "rm -rf /*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push --force-with-lease*": "deny"
    }
  },
  "agent": {
    "build": { "model": "opencode/big-pickle" },
    "plan": { "model": "opencode/glm-5.3-flash-free" },
    "general": { "model": "opencode/deepseek-v4.1-flash-free" },
    "explore": { "model": "opencode/nemotron-3.5-lightning-free" },
    "title": { "model": "opencode/mimo-v2.6-flash-free" },
    "summary": { "model": "opencode/mimo-v2.6-flash-free" },
    "compaction": { "model": "opencode/deepseek-v4.1-flash-free" }
  }
}
