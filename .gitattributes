# Scripts lancés par un interpréteur (bash, bats, Python) : fins de ligne LF
# même sur un checkout Windows (l'interpréteur échoue sur les CRLF)
*.sh                text eol=lf
*.conf              text eol=lf
*.bats              text eol=lf
*.bash              text eol=lf
*.py                text eol=lf
Dockerfile          text eol=lf
Makefile            text eol=lf
# Scripts bash sans extension (lancés directement)
manage/devzone            text eol=lf
.devcontainer/devzone   text eol=lf
*.yaml              text eol=lf
*.yml               text eol=lf
*.md                text eol=lf
charts/**           text eol=lf
# Reference files keep LF bytes on every workstation: with core.autocrlf a
# CRLF reference no longer matches the LF text from the program, and embedded
# CRLF data is baked into binaries built on Windows.
**/testdata/**      text eol=lf
**/golden/**        text eol=lf
**/goldens/**       text eol=lf
*.golden            text eol=lf
*.txt               text eol=lf
