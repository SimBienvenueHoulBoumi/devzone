# Chaque projet du workspace a son propre dépôt git
workspace/*
!workspace/.gitkeep

.DS_Store
.devzone.log
.devzone.state
.devzone.modules*
.password
.devzone.catalog-watcher/

# Dependencies of the wrapper charts devzone-argocd and devzone-gitlab, built
# by helm dependency build before the installation; their locks (Chart.lock)
# are committed
charts/devzone-argocd/charts/
charts/devzone-gitlab/charts/
/bin/
/.devcontainer/bin/
/dist/
